# CCPP schemes with OpenACC kernels: Kessler and the utility schemes it uses
# (gpu-fphystest-kessler).
GPU_SCHEME_OBJS=\
kessler.o \
kessler_update.o \
state_converters.o \
qneg.o \
geopotential_temp.o

# Generated CCPP caps (bld/atm/obj/ccpp) that contain OpenACC directives in a
# GPU build (xdsl_ccpp --directive acc). Other caps have none and get -noacc.
# Known exception: cam_ccpp_cap has no directives in a GPU RRTMGP build, but
# is listed by name, so it gets -acc there too (it only dispatches).
CCPP_GPU_CAP_OBJS=\
cam_ccpp_cap.o \
kessler_cap.o \
kessler_test_cap.o

# nvhpc flag policy: -acc ($(OPENACC_GPU_FLAGS)) only for the files listed in
# GPU_OBJS, i.e. GPU-enabled physics that contains OpenACC directives;
# everything else -noacc ($(ACC_OFF_FLAG)), here and in Tools/Makefile's
# generic rules, so nothing depends on the build environment. -Knoieee and
# -Mnofma come from FFLAGS (cmake_macros/nvhpc.cmake) for all files; GPU code
# adds -gpu=...,nofma,math_uniform. CPU and GPU runs must agree bit for bit.
# To enable a newly ported scheme, add its object to GPU_SCHEME_OBJS (or the
# package's list) and any cap that gains directives to CCPP_GPU_CAP_OBJS.
# The lists are explicit for now: MPAS's dycore has OpenACC directives that do
# not work yet, so -acc cannot be derived from the sources. Known exception:
# the Kessler builds compile CPU (directive-free) copies of the RRTMGP kernels
# mo_gas_optics_rrtmgp_kernels and mo_optical_props_kernels under the same
# names, so they get -acc there (never called).
GPU_OBJS := $(PUMAS_OBJS) $(RRTMGP_OBJS) $(CLUBB_OBJS) $(GPU_SCHEME_OBJS) $(CCPP_GPU_CAP_OBJS)

# 10/2025: Use -MllvmO0 as a temporary workaround for the CAM restart BFB issue
# seen with nvhpc/25.9. Remove this once the NVHPC bug is fixed and the linked
# issue documenting the workaround has been resolved. -Mnofma is repeated
# after -fast/-fastsse so they cannot turn FMA back on.
ifeq ($(DEBUG),FALSE)
  $(PERFOBJS): %.o: %.F90
	  $(FC) -c $(INCLDIR) $(INCS) $(FFLAGS) $(FREEFLAGS) -O3 -Mfprelaxed=div -MllvmO0 $(ACC_OFF_FLAG) $<
  $(REDUCED_OPT_OBJS): %.o: %.F90
	  $(FC) -c $(INCLDIR) $(INCS) $(FFLAGS) $(FREEFLAGS) -O1 -MllvmO0 $(ACC_OFF_FLAG) $<
  $(REDUCED_PRECISION_OBJS): %.o: %.F90
	  $(FC) -c $(INCLDIR) $(INCS) $(FFLAGS) $(FREEFLAGS) -fast -Mnofma -MllvmO0 $(ACC_OFF_FLAG) $<
  $(SHR_RANDNUM_FORT_OBJS): %.o: %.F90
	  $(FC) -c $(INCLDIR) $(INCS) $(FFLAGS) $(FREEFLAGS) -O3 -fast -Mnofma -Mfprelaxed=div,sqrt -MllvmO0 $(ACC_OFF_FLAG) $<
#  $(SHR_RANDNUM_C_OBJS): %.o: %.c
#	  $(CC) -c $(INCLDIR) $(INCS) $(CFLAGS) -O3 -fast $<
  $(PUMAS_OBJS): %.o: %.F90
	  $(FC) -c $(INCLDIR) $(INCS) $(FFLAGS) $(FREEFLAGS) -O3 -fastsse -Mnofma -Mflushz -Mfprelaxed=sqrt -MllvmO0 $(OPENACC_GPU_FLAGS) $<
  GPU_PLAIN_OBJS := $(filter-out $(PUMAS_OBJS),$(GPU_OBJS))

ifeq ($(COMP_NAME),mpaso)
  # mpas ocean files need gpuflags
  FFLAGS +=$(GPUFLAGS)
endif

else
  $(REDUCED_ERRORCHKS_IN_DEBUG): %.o: %.F90
	  $(FC) -c $(INCLDIR) $(INCS) $(FFLAGS) $(FREEFLAGS) -Mnobounds -Ktrap=none -Knoieee $(ACC_OFF_FLAG) $<
  GPU_PLAIN_OBJS := $(GPU_OBJS)
endif

# GPU_OBJS get -acc in DEBUG builds too (needed for real device residency in
# DEBUG CPU-vs-GPU comparisons); this rule adds no optimization flags on top
# of $(FFLAGS). OPENACC_GPU_FLAGS is -noacc on a non-GPU case. $(CONTIGUOUS_FLAG)
# is carried over from Tools/Makefile's generic .F90.o rule (coords_1d.F90
# and others need the USE_CONTIGUOUS macro).
$(GPU_PLAIN_OBJS): %.o: %.F90
	$(FC) -c $(INCLDIR) $(INCS) $(FFLAGS) $(FREEFLAGS) $(CONTIGUOUS_FLAG) $(OPENACC_GPU_FLAGS) $<

# NOTE: MPAS's own dycore .F files are NOT built through this Makefile at
# all -- they go through a completely separate recursive sub-make
# ($(MAKE) -C $(MPAS_LIBDIR) ..., the "libmpas:" rule in cime/CIME/Tools/
# Makefile, which invokes MPAS's own Makefile.CESM/Makefile.in.CESM/
# core_atmosphere Makefiles). A rule here for MPAS object names was tried
# and confirmed dead: it never fires, because Make never routes MPAS's
# compile through this file's rules in the first place. See
# cime/CIME/Tools/Makefile's own "libmpas:" rule for the real fix location
# (MPAS_DYCORE_GPU_OFFLOAD is threaded through FFLAGS there instead).
